<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaIDE.ViewModels"
        xmlns:aedit="https://github.com/avaloniaui/avaloniaedit"
        x:Class="AvaloniaIDE.Views.EditWindow"
        x:DataType="vm:EditWindowViewModel"
        Name="RootWindow"
        Title="EditWindow">
    <DockControl InitializeLayout="True" InitializeFactory="True">
        <DockControl.Factory>
            <Factory />
        </DockControl.Factory>
        <RootDock>
            <ProportionalDock>
                <ToolDock Proportion="0.25" Alignment="Left" CanClose="False" Title="Solution">
                    <Tool Id="SolutionTool" Title="Solution" CanClose="False">
                        <TreeView />
                    </Tool>
                </ToolDock>
                
                <ProportionalDockSplitter CanResize="True" />

                <DocumentDock Proportion="0.75"
                              ItemsSource="{Binding #RootWindow.((vm:EditWindowViewModel)DataContext).Documents}">
                    <DocumentDock.DocumentTemplate>
                        <DocumentTemplate>
                            <aedit:TextEditor ShowLineNumbers="True"
                                              FontFamily="Cascadia Code,Consolas,Menlo,Monospace"/>
                        </DocumentTemplate>
                    </DocumentDock.DocumentTemplate>
                </DocumentDock>
            </ProportionalDock>
        </RootDock>
    </DockControl>
</Window>
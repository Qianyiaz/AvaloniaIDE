<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaIDE.ViewModels"
        x:Class="AvaloniaIDE.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AvaloniaIDE">

    <Grid ColumnDefinitions="250,4,*">
        <StackPanel Margin="35,25,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AvaloniaIDE" />
                <SelectableTextBlock Text="v1.0.0"
                                     Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}" />

        <DockPanel Margin="8"
                   Grid.Column="2"
                   VerticalSpacing="5">
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="5">
                <AutoCompleteBox PlaceholderText="Search your projects" />
                <Button Grid.Column="1"
                        Content="Open Sln File">
                    <Interaction.Behaviors>
                        <ButtonOpenFilePickerBehavior Title="Select a Solution File"
                                                      FileTypeFilter="Solution Files|*.sln;*.slnx"
                                                      Command="{Binding OpenSolutionCommand}" />
                    </Interaction.Behaviors>
                </Button>
            </Grid>

            <CheckBox DockPanel.Dock="Bottom"
                      Content="Auto-open last sln" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>